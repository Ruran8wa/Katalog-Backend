# ─────────────────────────────────────────────────────────────────────────────
# Katalog-Backend · Environment Variable Reference
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── SQL Server ───────────────────────────────────────────────────────────────
# Password for the SQL Server "sa" account used by Docker and the connection string.
SA_PASSWORD=YourStrong!Passw0rd

# Optional: override the SQL Server container port exposed to the host (default 1433).
DB_PORT=1433

# Optional: override the database name (default KatalogDb).
DB_NAME=KatalogDb

# ── ASP.NET Core ─────────────────────────────────────────────────────────────
# Environment name – controls which appsettings.<env>.json is loaded.
ASPNETCORE_ENVIRONMENT=Development

# Host port that the API container is published on (default 5297).
APP_PORT=5297

# ── JWT Authentication ────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_KEY=CHANGE_ME_use_at_least_32_chars_of_random_secret

# Token issuer / audience must match the values your front-end sends.
JWT_ISSUER=KatalogBackend
JWT_AUDIENCE=KatalogClient

# Token lifetime in minutes.
JWT_EXPIRE_TIME=60

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Find these in your Cloudinary dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Azure Service Bus ─────────────────────────────────────────────────────────
# Full primary/secondary connection string from the Azure portal.
AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=CHANGE_ME
AZURE_SERVICE_BUS_TOPIC=order-placed-topic
AZURE_SERVICE_BUS_SUBSCRIPTION=order-stock-worker-sub

# ── Background Services / Workers ─────────────────────────────────────────────
# Control whether this process runs background workers (Consumer / Outbox Publisher).
# For example, in an API-only container: Consumer__Enabled=false
# Can be set via Consumer__Enabled=false or CONSUMER_ENABLED=false
CONSUMER_ENABLED=true
OUTBOX_PUBLISHER_ENABLED=true

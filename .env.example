# ─────────────────────────────────────────────────────────────────────────────
# Katalog-Backend · Environment Variable Reference
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── SQL Server ───────────────────────────────────────────────────────────────
# Password for the SQL Server "sa" account used by Docker and the connection string.
SA_PASSWORD=YourStrong!Passw0rd

# Optional: override the SQL Server container port exposed to the host (default 1433).
DB_PORT=1433

# Optional: override the database name (default KatalogDb).
DB_NAME=KatalogDb

# ── ASP.NET Core ─────────────────────────────────────────────────────────────
# Environment name – controls which appsettings.<env>.json is loaded.
ASPNETCORE_ENVIRONMENT=Development

# Host port that the API container is published on (default 5297).
APP_PORT=5297

# Grafana host port and initial admin login.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ── JWT Authentication ────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_KEY=CHANGE_ME_use_at_least_32_chars_of_random_secret

# Token issuer / audience must match the values your front-end sends.
JWT_ISSUER=KatalogBackend
JWT_AUDIENCE=KatalogClient

# Token lifetime in minutes.
JWT_EXPIRE_TIME=60

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Find these in your Cloudinary dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Azure Service Bus ─────────────────────────────────────────────────────────
# Full primary/secondary connection string from the Azure portal.
# For local Compose, leave this unset to use the emulator connection string.
# For Azure, use the namespace connection string and set the queue name below.
# AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=...;SharedAccessKey=...
AZURE_SERVICE_BUS_QUEUE=orders-queue
AZURE_SERVICE_BUS_MAX_CONCURRENT_SESSIONS=1
AZURE_SERVICE_BUS_MAX_CONCURRENT_CALLS_PER_SESSION=1
AZURE_SERVICE_BUS_SESSION_IDLE_TIMEOUT_SECONDS=1

# ── Background Services / Workers ─────────────────────────────────────────────
# Control whether this process runs background workers (Consumer / Outbox Publisher).
# For example, in an API-only container: BackgroundServices__ConsumerEnabled=false
BackgroundServices__ConsumerEnabled=true
BackgroundServices__OutboxPublisherEnabled=true

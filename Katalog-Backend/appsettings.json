{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=KatalogDb;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "CHANGE_ME_IN_USER_SECRETS_OR_ENV!",
    "Issuer": "KatalogBackend",
    "Audience": "KatalogClient",
    "ExpireTime": "60"
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUD_NAME",
    "ApiKey": "YOUR_API_KEY",
    "ApiSecret": "YOUR_API_SECRET"
  },
  "AzureServiceBus": {
    "ConnectionString": "",
    "QueueName": "orders-queue",
    "MaxConcurrentSessions": 1,
    "MaxConcurrentCallsPerSession": 1,
    "SessionIdleTimeoutSeconds": 1
  },
  "BackgroundServices": {
    "ConsumerEnabled": true,
    "OutboxPublisherEnabled": true
  }
}
